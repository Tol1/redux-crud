{
  "name": "redux-crud-mb",
  "version": "1.0.0",
  "description": "Redux CRUD",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "tsc && c8 ava dist/**/*.test.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --bracket-spacing=false --write 'src/**/*.ts'",
    "precommit": "lint-staged",
    "prepare": "npm run build"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write --bracket-spacing=false",
      "git add"
    ]
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Tol1/redux-crud"
  },
  "keywords": [
    "redux",
    "crud"
  ],
  "author": "Versent",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Versent/redux-crud/issues"
  },
  "homepage": "https://github.com/Versent/redux-crud",
  "devDependencies": {
    "@types/ramda": "^0.30.2",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "ava": "^6.0.1",
    "c8": "^9.1.0",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.0.4",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "husky": "^0.14.3",
    "lint-staged": "^4.2.1",
    "prettier": "^1.3.1",
    "testdouble": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "fast-equals": "^5.0.1",
    "invariant": "^2.1.0",
    "lodash.snakecase": "^4.1.1",
    "ramda": "^0.29.1"
  },
  "ava": {
    "failFast": true
  },
  "nyc": {
    "include": [
      "dist/**/*"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ]
  }
}
